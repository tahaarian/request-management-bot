# API Configuration
API_BASE_URL=https://famsapi.pod.ir
API_TOKEN=CBBC0CE2-D0BE-49B5-B1B3-E6ADB7000C80

# Polling Configuration (milliseconds)
POLL_INTERVAL_MS=10000

# Request filter: comma-separated state IDs to process (e.g. new state)
ALLOWED_STATE_IDS=1

# Request list type (1=received, 2=sent, 3=all-sent, 5=all-received)
REQUEST_LIST_TYPE=1

# Discussion text to add
DISCUSSION_TEXT=این درخواست دریافت شد و در حال بررسی است.

# Your SSO ID (optional, for discussion creator)
CREATOR_SSO_ID=54566626

# Excel file path for account manager mapping
ACCOUNT_MANAGER_EXCEL_PATH=./account_managers.xlsx
# Column name in Excel for business/project ID
EXCEL_BIZ_ID_COLUMN=bizId
# Column name in Excel for account manager name
EXCEL_MANAGER_NAME_COLUMN=managerName

# Field ID in request info that holds the business identifier
BIZ_FIELD_ID=27079

# Dashboard port
DASHBOARD_PORT=3001

# DB path
DB_PATH=./data/fams.db
